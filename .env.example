# DeepSeek API (default provider)
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Or use an Ollama OpenAI-compatible endpoint
# DEEPSEEK_API_PROVIDER=ollama
# DEEPSEEK_API_BASE=http://127.0.0.1:11434/v1
# DEEPSEEK_MODEL=qwen2.5-coder:7b

# Optional: enable iterative multi-hop answering in the benchmark adapter
# WHALE_YING_ITERATIVE=1
